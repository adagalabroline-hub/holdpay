<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_holdpay_service_contract_portal" model="ir.rule">
    <field name="name">HoldPay service agreements: participating client/provider</field>
    <field name="model_id" ref="model_holdpay_service_contract"/>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="domain_force">['|', ('buyer_id', '=', user.partner_id.id), ('seller_id', '=', user.partner_id.id)]</field>
  </record>
  <record id="rule_holdpay_service_milestone_portal" model="ir.rule">
    <field name="name">HoldPay service milestones: agreement participants</field>
    <field name="model_id" ref="model_holdpay_service_milestone"/>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="domain_force">['|', ('contract_id.buyer_id', '=', user.partner_id.id), ('contract_id.seller_id', '=', user.partner_id.id)]</field>
  </record>
</odoo>
